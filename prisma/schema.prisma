// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  vehicles  Vehicle[]
  geofences Geofence[]
  commands  Command[]
  financials Financial[]
}

model Vehicle {
  id        Int        @id @default(autoincrement())
  plate     String     @unique
  model     String?
  driver    String?
  userId    Int
  user      User       @relation(fields: [userId], references: [id])
  locations Location[]
  alerts    Alert[]
  commands  Command[]
  telemetry Telemetry[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Location {
  id        Int      @id @default(autoincrement())
  latitude  Float
  longitude Float
  speed     Float?
  heading   Float?
  timestamp DateTime @default(now())
  vehicleId Int
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
}

model Telemetry {
  id        Int      @id @default(autoincrement())
  vehicleId Int
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  timestamp DateTime @default(now())
  speed     Float?
  fuelLevel Float?
  battery   Float?
  ignition  Boolean?
  rpm       Int?
  temp      Float?
}

model Alert {
  id        Int      @id @default(autoincrement())
  type      String   
  severity  String   
  status    String   
  message   String?
  timestamp DateTime @default(now())
  vehicleId Int
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
}

model Geofence {
  id          Int      @id @default(autoincrement())
  name        String
  type        String   
  coordinates Json     
  color       String?
  active      Boolean  @default(true)
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}

model Command {
  id        Int      @id @default(autoincrement())
  command   String   
  status    String   
  vehicleId Int
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  sentAt    DateTime @default(now())
  executedAt DateTime?
}

model Financial {
  id          Int      @id @default(autoincrement())
  type        String   // BOLETO, PIX
  description String
  amount      Float
  dueDate     DateTime?
  paidAt      DateTime?
  status      String   // PENDING, PAID, OVERDUE, FAILED
  barcode     String?
  url         String?  // PDF or Receipt URL
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
